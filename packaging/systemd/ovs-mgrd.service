[Unit]
Description=OVS WebUI privileged management service
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=ovs-webui-web
EnvironmentFile=/etc/ovs-webui/runtime.env
ExecStart=/usr/libexec/ovs-mgrd --socket=${MANAGER_SOCKET} --webd-uid=${WEBD_UID} --webd-gid=${WEBD_GID}
RuntimeDirectory=ovs-webui
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0077
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/run/ovs-webui
MemoryMax=128M
TasksMax=64
LimitNOFILE=256
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
