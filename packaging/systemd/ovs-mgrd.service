[Unit]
Description=OVS WebUI privileged management service
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=10s
User=root
Group=ovs-webui-web
EnvironmentFile=/etc/ovs-webui/runtime.env
ExecStart=/usr/libexec/ovs-mgrd --socket=${MANAGER_SOCKET} --webd-uid=${WEBD_UID} --webd-gid=${WEBD_GID} --database=${MANAGER_DATABASE}
StateDirectory=ovs-webui/manager
StateDirectoryMode=0700
RuntimeDirectory=ovs-webui
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0077
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/run/ovs-webui
# Two bounded 64 MiB Argon2id workers plus authority/schema/SQLite overhead.
Environment=GOMEMLIMIT=192MiB
MemoryMax=256M
TasksMax=64
LimitNOFILE=256
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
