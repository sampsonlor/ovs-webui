# Root-owned configuration; resolve the installed service account's actual IDs.
# Zero is deliberately invalid. No users, certificates or OVS are installed here.
WEBD_UID=0
WEBD_GID=0
MANAGER_SOCKET=/run/ovs-webui/mgrd.sock
MANAGER_DATABASE=/var/lib/ovs-webui/manager/manager.db
WEB_DATABASE=/var/lib/ovs-webui/web/web.db
HTTPS_LISTEN=127.0.0.1:8443
# Set the exact HTTPS origin used by browsers before enabling authentication.
PUBLIC_ORIGIN=https://127.0.0.1:8443
TLS_CERT=/etc/ovs-webui/tls/server.crt
TLS_KEY=/etc/ovs-webui/tls/server.key
