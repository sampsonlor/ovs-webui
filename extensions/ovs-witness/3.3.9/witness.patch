+#ifdef ENABLE_OVS_WEBUI_WITNESS
+/* Called on the main thread, as are the two engine create/unref paths.
+ * Protocol worker updates are protected by each library's own mutex. */
+static int
+webui_snapshot(struct ofproto *ofproto_, struct webui_native *s)
+{
+    struct ofproto_dpif *p = ofproto_dpif_cast(ofproto_);
+    memset(s, 0, sizeof *s);
+    s->instance = ofproto_->webui_instance;
+    s->stp_enabled = p->stp != NULL;
+    s->rstp_enabled = p->rstp != NULL;
+    if (p->stp) {
+        stp_webui_snapshot(p->stp, &s->stp);
+    }
+    if (p->rstp) {
+        rstp_webui_snapshot(p->rstp, &s->rstp);
+    }
+    return 0;
+}
+#endif

